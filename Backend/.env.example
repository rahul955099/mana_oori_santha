PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
# Get this from Atlas -> Database -> Connect -> Drivers
# Replace <username>, <password>, and <db-name> (use mana-oori-santha as the db name)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/mana-oori-santha?retryWrites=true&w=majority

# Use a long, random string in real environments (never reuse this example value)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

# Used only by `npm run seed` to create the first admin and the sample seller
# accounts. Choose your own strong values (8+ characters); never commit them.
SEED_ADMIN_EMAIL=admin@manaoorisantha.local
SEED_ADMIN_PASSWORD=
SEED_SELLER_PASSWORD=

# Delivery and order rules (optional — these are the defaults).
DELIVERY_CHARGE=40
FREE_DELIVERY_ABOVE=500
RETURN_WINDOW_DAYS=7
# Comma-separated pincode prefixes you deliver to, e.g. 50,51,52,53 for Telangana
# and Andhra Pradesh. Leave empty to accept every valid Indian pincode.
SERVICEABLE_PINCODE_PREFIXES=

# Cloudinary image uploads (Settings → API Keys in the Cloudinary console).
# The secret stays on the server; the browser only ever gets short-lived signatures.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Platform commission taken from each seller sale, in percent.
PLATFORM_COMMISSION_PERCENT=5

# Outgoing email via SMTP, e.g. Brevo (Settings → SMTP & API → SMTP).
# MAIL_FROM must be a sender address you've verified with the provider.
# Leave empty in development: emails are then printed to the server log.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Mana Oori Santha <you@example.com>
