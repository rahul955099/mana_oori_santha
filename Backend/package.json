    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "ts-node src/seed/seed.ts",
    "test": "node --require ts-node/register --test src/tests/*.test.ts",
