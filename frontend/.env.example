# Optional. Base URL for reverse-geocoding "use my current location" lookups.
# Defaults to the free OpenStreetMap Nominatim API (https://nominatim.openstreetmap.org)
# which needs no API key. Point this at your own backend proxy if you later
# connect a paid/rate-limited geocoding provider — never put a provider's
# secret key directly in frontend code or env vars prefixed with VITE_.
VITE_GEOCODING_API_BASE_URL=

# Base URL of the Mana Oori Santha backend API (no trailing slash).
VITE_API_URL=http://localhost:5000/api

# Optional: your social media page links for the footer (icons are hidden when empty).
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_TWITTER=
